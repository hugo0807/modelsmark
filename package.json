{
  "name": "modelsmark",
  "version": "0.1.0",
  "private": true,
  "description": "全球模型 API 价格与能力基准实时对比平台",
  "scripts": {
    "dev": "next dev",
    "prebuild": "node scripts/clean-out.cjs",
    "build": "node scripts/build-compat.cjs && node scripts/clean-out.cjs --purge",
    "build:raw": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "data:ingest": "tsx scripts/ingest.ts",
    "data:models": "tsx scripts/build-models.ts",
    "data:clean": "tsx scripts/clean-models.ts",
    "data:intel": "tsx scripts/merge-intelligence.ts",
    "data:fetch-intel": "tsx scripts/fetch-intelligence.ts",
    "data:pipeline": "npm run data:ingest && npm run data:models && npm run data:clean && npm run data:intel",
    "scrape": "npm run data:pipeline",
    "scrape:one": "tsx scripts/ingest.ts",
    "validate": "tsx scripts/validate-data.ts",
    "export": "node scripts/export-snapshot.mjs",
    "secret": "python scripts/write-gh-secrets.py"
  },
  "dependencies": {
    "next": "^15.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "engines": {
    "node": "22.x"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "playwright": "^1.49.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
